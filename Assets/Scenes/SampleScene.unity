  subtitleText: {fileID: 165160120}
  subtitles:
  - startTime: 5
    duration: 5
    text: " Si vous entendez cet enregistrement, c\u2019est que vous avez atteint
      le Poste 4 en toute s\xE9curit\xE9. "
  - startTime: 11
    duration: 4
    text: "Comme vous le savez, notre nation est en proie \xE0 une guerre contre
      l\u2019ennemi."
  - startTime: 15.5
    duration: 5
    text: "Nous pr\xE9f\xE9rons prendre toutes nos pr\xE9cautions et intercepter
      les potentielles menaces."
  - startTime: 20.1
    duration: 2.2
    text: "C\u2019est en quoi, votre mission est d'intercepter,"
  - startTime: 23.03
    duration: 1
    text: 'analyser '
  - startTime: 23.03
    duration: 4
    text: "et d\xE9chiffrer chaque transmission ennemie gr\xE2ce \xE0 cette vieille
      radio."
